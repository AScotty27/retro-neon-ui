<!-- retro-neon-ui for WPF: fonts, brushes, glows and keyed styles. MIT license.
     Setup (CLAUDE.md, section "WPF", has the full steps):
       1. Copy RetroColors.xaml, RetroNeon.xaml (and RetroNeon.Implicit.xaml for app-wide defaults) into one folder of
          the app project, e.g. Themes\ (Build Action: Page).
       2. Copy dotnet\fonts\*.ttf into the app project's Fonts\ folder (Build Action: Resource).
       3. App.xaml: <ResourceDictionary Source="Themes/RetroNeon.Implicit.xaml" /> in Application.Resources'
          MergedDictionaries (or RetroNeon.xaml for keyed styles only).
       4. Windows: Style="{StaticResource Rt.Window}" (implicit Window styles do not reach derived window classes).
     Keys: Rt.Font.*, Rt.Brush.* (with RetroColors.xaml), Rt.Glow.*, Rt.Window, Rt.Text.Title / Subtitle / Label /
     Terminal / Body / Muted, Rt.Button (neutral) / .Primary / .Secondary / .Success / .Danger, Rt.TextBox,
     Rt.PasswordBox, Rt.CheckBox, Rt.Switch, Rt.ProgressBar, Rt.Card, Rt.Alert.Info / Success / Warning / Danger,
     Rt.Tag (+ .Accent / .Info / .Success / .Warning / .Danger), Rt.DataGrid, Rt.ToolTip, Rt.StripeBar, Rt.Trail,
     Rt.Scanlines, Rt.ScrollBar. Write button and tag labels in capitals: WPF has no text-transform. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="RetroColors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ========== Fonts (TTF files in the app's Fonts\ folder, Build Action Resource) ========== -->
    <FontFamily x:Key="Rt.Font.Display">pack://application:,,,/Fonts/#Exo 2</FontFamily>
    <FontFamily x:Key="Rt.Font.Body">pack://application:,,,/Fonts/#Space Grotesk</FontFamily>
    <FontFamily x:Key="Rt.Font.Pixel">pack://application:,,,/Fonts/#Press Start 2P</FontFamily>
    <FontFamily x:Key="Rt.Font.Term">pack://application:,,,/Fonts/#VT323</FontFamily>

    <!-- ========== Extra brushes (the palette itself is in RetroColors.xaml) ========== -->
    <LinearGradientBrush x:Key="Rt.Brush.Window" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FF150C2B" Offset="0" />
        <GradientStop Color="#FF050409" Offset="0.5" />
        <GradientStop Color="#FF0B0612" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Rt.Brush.Panel" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#E016112A" Offset="0" />
        <GradientStop Color="#F00A0814" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Rt.Brush.PrimaryFill" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFFFF27A" Offset="0" />
        <GradientStop Color="#FFFFD60A" Offset="0.55" />
        <GradientStop Color="#FFFFAE00" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Rt.Brush.Input" Color="#FF07060E" />
    <SolidColorBrush x:Key="Rt.Brush.LineStrong" Color="#61A63DFF" />
    <SolidColorBrush x:Key="Rt.Brush.Hover" Color="#0F2DE2FF" />
    <SolidColorBrush x:Key="Rt.Brush.Selection" Color="#99FF2E9A" />
    <SolidColorBrush x:Key="Rt.Brush.DangerText" Color="#FFFF8B96" />

    <!-- CRT scanlines: one dark line every 3 px. Use via the Rt.Scanlines style below. -->
    <DrawingBrush x:Key="Rt.Brush.Scanlines" TileMode="Tile" Stretch="None"
                  Viewport="0,0,1,3" ViewportUnits="Absolute" Viewbox="0,0,1,3" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00000000">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1,3" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#2B000000">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1,1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- LED segment gaps for the progress meter: a dark 3 px bar every 12 px. -->
    <DrawingBrush x:Key="Rt.Brush.Segments" TileMode="Tile" Stretch="None"
                  Viewport="0,0,12,1" ViewportUnits="Absolute" Viewbox="0,0,12,1" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00000000">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,12,1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF07060E">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="9,0,3,1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ========== Window and text ========== -->
    <Style x:Key="Rt.Window" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Rt.Brush.Window}" />
        <Setter Property="Foreground" Value="{StaticResource Rt.Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Rt.Font.Body}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Rt.Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Rt.Font.Display}" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource Rt.Brush.Yellow}" />
        <Setter Property="Effect" Value="{StaticResource Rt.Glow.Yellow}" />
    </Style>

    <Style x:Key="Rt.Text.Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Rt.Font.Display}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="Foreground" Value="{StaticResource Rt.Brush.Text}" />
    </Style>

    <Style x:Key="Rt.Text.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Rt.Font.Pixel}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource Rt.Brush.Cyan}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="0" BlurRadius="8" Color="#FF2DE2FF" Opacity="0.45" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Rt.Text.Terminal" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Rt.Font.Term}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource Rt.Brush.Green}" />
        <Setter Property="Effect" Value="{StaticResource Rt.Glow.Green}" />
    </Style>

    <Style x:Key="Rt.Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Rt.Font.Body}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Rt.Brush.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Rt.Text.Muted" TargetType="TextBlock" BasedOn="{StaticResource Rt.Text.Body}">
        <Setter Property="Foreground" Value="{StaticResource Rt.Brush.Muted}" />
        <Setter Property="LineHeight" Value="24" />
    </Style>

    <!-- ========== Decorations ========== -->
    <Style x:Key="Rt.StripeBar" TargetType="Rectangle">
        <Setter Property="Height" Value="3" />
        <Setter Property="Fill" Value="{StaticResource Rt.Brush.Stripes}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="Rt.Trail" TargetType="Rectangle">
        <Setter Property="Height" Value="13" />
        <Setter Property="Fill" Value="{StaticResource Rt.Brush.Trail}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="0" BlurRadius="10" Color="#FFFF2E9A" Opacity="0.55" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Put a Rectangle with this style as the LAST child of the window's root Grid (spanning every row and column). -->
    <Style x:Key="Rt.Scanlines" TargetType="Rectangle">
        <Setter Property="Fill" Value="{StaticResource Rt.Brush.Scanlines}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Panel.ZIndex" Value="1000" />
    </Style>

    <!-- ========== Buttons: slanted neon tube, rainbow drop on hover ========== -->
    <Style x:Key="Rt.Button" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Rt.Brush.Text}" />
        <Setter Property="Background" Value="#0AFFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource Rt.Brush.Line}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="FontFamily" Value="{StaticResource Rt.Font.Display}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="22,11" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Margin="8,0,8,6" Background="Transparent">
                        <Border x:Name="Drop" Background="{StaticResource Rt.Brush.Stripes}" CornerRadius="4" Opacity="0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <SkewTransform AngleX="-14" />
                                    <TranslateTransform X="-6" Y="6" />
                                </TransformGroup>
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="Tube" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <SkewTransform AngleX="-14" />
                            </Border.RenderTransform>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Drop" Property="Opacity" Value="1" />
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="2" Y="-2" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Drop" Property="Opacity" Value="1" />
                            <Setter TargetName="Tube" Property="BorderBrush" Value="{StaticResource Rt.Brush.Cyan}" />
                            <Setter TargetName="Tube" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="0" Y="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            <Setter TargetName="Drop" Property="Opacity" Value="0" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Rt.Button.Primary" TargetType="Button" BasedOn="{StaticResource Rt.Button}">
        <Setter Property="Background" Value="{StaticResource Rt.Brush.PrimaryFill}" />
        <Setter Property="BorderBrush" Value="#99FFFAC8" />
        <Setter Property="Foreground" Value="#FF1A0F00" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="0" BlurRadius="18" Color="#FFFFD60A" Opacity="0.55" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Rt.Button.Secondary" TargetType="Button" BasedOn="{StaticResource Rt.Button}">
        <Setter Property="Background" Value="#0F2DE2FF" />
        <Setter Property="BorderBrush" Value="{StaticResource Rt.Brush.Cyan}" />
        <Setter Property="Foreground" Value="{StaticResource Rt.Brush.Cyan}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="0" BlurRadius="14" Color="#FF2DE2FF" Opacity="0.45" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Rt.Button.Success" TargetType="Button" BasedOn="{StaticResource Rt.Button}">
        <Setter Property="Background" Value="#125DFF8F" />
        <Setter Property="BorderBrush" Value="{StaticResource Rt.Brush.Green}" />
        <Setter Property="Foreground" Value="{StaticResource Rt.Brush.Green}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="0" BlurRadius="14" Color="#FF5DFF8F" Opacity="0.4" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Rt.Button.Danger" TargetType="Button" BasedOn="{StaticResource Rt.Button}">
        <Setter Property="Background" Value="#12FF4D5E" />
        <Setter Property="BorderBrush" Value="{StaticResource Rt.Brush.Red}" />
        <Setter Property="Foreground" Value="{StaticResource Rt.Brush.DangerText}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="0" BlurRadius="14" Color="#FFFF4D5E" Opacity="0.45" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Text inputs ========== -->
    <ControlTemplate x:Key="Rt.InputTemplate" TargetType="Control">
        <Grid>
            <Border x:Name="Halo" CornerRadius="6" BorderBrush="{StaticResource Rt.Brush.Cyan}" BorderThickness="1" Opacity="0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="18" Color="#FF2DE2FF" Opacity="0.6" />
                </Border.Effect>
            </Border>
            <Border x:Name="Frame" CornerRadius="6" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <ScrollViewer x:Name="PART_ContentHost" Margin="0" Padding="{TemplateBinding Padding}" VerticalAlignment="Center"
                              Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="#99A63DFF" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Rt.Brush.Cyan}" />
                <Setter TargetName="Halo" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Rt.TextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Rt.Brush.Input}" />
        <Setter Property="Foreground" Value="{StaticResource Rt.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Rt.Brush.LineStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource Rt.Brush.Yellow}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Rt.Brush.Selection}" />
        <Setter Property="FontFamily" Value="{StaticResource Rt.Font.Body}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource Rt.InputTemplate}" />
    </Style>

    <Style x:Key="Rt.PasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource Rt.Brush.Input}" />
        <Setter Property="Foreground" Value="{StaticResource Rt.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Rt.Brush.LineStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource Rt.Brush.Yellow}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Rt.Brush.Selection}" />
        <Setter Property="FontFamily" Value="{StaticResource Rt.Font.Body}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource Rt.InputTemplate}" />
    </Style>

    <!-- ========== Check box (neon box) and switch (for CheckBox or ToggleButton) ========== -->
    <Style x:Key="Rt.CheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Rt.Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Rt.Font.Body}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="20" Height="20" CornerRadius="4" Background="{StaticResource Rt.Brush.Input}"
                                BorderBrush="{StaticResource Rt.Brush.LineStrong}" BorderThickness="1.5" VerticalAlignment="Center">
                            <Path x:Name="Mark" Data="M 4,10 L 8,14 L 16,5" Stroke="{StaticResource Rt.Brush.C6}" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Rt.Brush.C6}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Rt.Brush.Cyan}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Rt.Brush.Cyan}" />
                            <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Rt.Switch" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Rt.Brush.Muted}" />
        <Setter Property="FontFamily" Value="{StaticResource Rt.Font.Term}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Track" Width="50" Height="26" CornerRadius="13" Background="{StaticResource Rt.Brush.Input}"
                                BorderBrush="{StaticResource Rt.Brush.Line}" BorderThickness="1" VerticalAlignment="Center">
                            <Ellipse x:Name="Knob" Width="18" Height="18" Margin="3,0" HorizontalAlignment="Left"
                                     Fill="{StaticResource Rt.Brush.Muted}" />
                        </Border>
                        <ContentPresenter x:Name="Text" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Rt.Brush.Green}" />
                            <Setter TargetName="Knob" Property="Effect" Value="{StaticResource Rt.Glow.Green}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Rt.Brush.Green}" />
                            <Setter Property="Foreground" Value="{StaticResource Rt.Brush.Green}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Rt.Brush.Cyan}" />
                            <Setter TargetName="Track" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Progress: rainbow level meter with LED segments (IsIndeterminate = dimmed full meter) ========== -->
    <Style x:Key="Rt.ProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource Rt.Brush.StripesSoft}" />
        <Setter Property="Background" Value="{StaticResource Rt.Brush.Input}" />
        <Setter Property="BorderBrush" Value="{StaticResource Rt.Brush.Line}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" SnapsToDevicePixels="True">
                        <Grid Margin="3" ClipToBounds="True">
                            <Rectangle x:Name="PART_Track" Fill="Transparent" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" ClipToBounds="True" CornerRadius="2">
                                <Rectangle Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left"
                                           Width="{Binding ActualWidth, ElementName=PART_Track}" />
                            </Border>
                            <Rectangle Fill="{StaticResource Rt.Brush.Segments}" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="HorizontalAlignment" Value="Stretch" />
                            <Setter TargetName="PART_Indicator" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Card: dark panel, stripe cap, soft drop shadow (use on a ContentControl) ========== -->
    <Style x:Key="Rt.Card" TargetType="ContentControl">
        <Setter Property="Padding" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource Rt.Brush.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border CornerRadius="10" Background="{StaticResource Rt.Brush.Panel}" BorderBrush="{StaticResource Rt.Brush.Line}"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="10" Direction="270" BlurRadius="36" Color="#FF000000" Opacity="0.5" />
                            </Border.Effect>
                        </Border>
                        <Border Height="3" Margin="1,1,1,0" VerticalAlignment="Top" CornerRadius="9,9,0,0" Opacity="0.85"
                                Background="{StaticResource Rt.Brush.Stripes}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Alerts (ContentControl): tinted box, tone bar on the left, pixel label from Tag ========== -->
    <Style x:Key="Rt.Alert.Info" TargetType="ContentControl">
        <Setter Property="Tag" Value="INFO" />
        <Setter Property="BorderBrush" Value="{StaticResource Rt.Brush.Info}" />
        <Setter Property="Background" Value="#122DE2FF" />
        <Setter Property="Foreground" Value="{StaticResource Rt.Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Rt.Font.Body}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="4,1,1,1" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Margin="0,4,14,0" VerticalAlignment="Top" Text="{TemplateBinding Tag}"
                                       Foreground="{TemplateBinding BorderBrush}" FontFamily="{StaticResource Rt.Font.Pixel}" FontSize="9" />
                            <ContentPresenter />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Rt.Alert.Success" TargetType="ContentControl" BasedOn="{StaticResource Rt.Alert.Info}">
        <Setter Property="Tag" Value="OK" />
        <Setter Property="BorderBrush" Value="{StaticResource Rt.Brush.Success}" />
        <Setter Property="Background" Value="#125DFF8F" />
    </Style>

    <Style x:Key="Rt.Alert.Warning" TargetType="ContentControl" BasedOn="{StaticResource Rt.Alert.Info}">
        <Setter Property="Tag" Value="WARN" />
        <Setter Property="BorderBrush" Value="{StaticResource Rt.Brush.Warning}" />
        <Setter Property="Background" Value="#12FF8C1A" />
    </Style>

    <Style x:Key="Rt.Alert.Danger" TargetType="ContentControl" BasedOn="{StaticResource Rt.Alert.Info}">
        <Setter Property="Tag" Value="ERROR" />
        <Setter Property="BorderBrush" Value="{StaticResource Rt.Brush.Danger}" />
        <Setter Property="Background" Value="#12FF4D5E" />
    </Style>

    <!-- ========== Tags (on a Label) ========== -->
    <Style x:Key="Rt.Tag" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource Rt.Brush.Muted}" />
        <Setter Property="BorderBrush" Value="{StaticResource Rt.Brush.Line}" />
        <Setter Property="Background" Value="#08FFFFFF" />
        <Setter Property="FontFamily" Value="{StaticResource Rt.Font.Pixel}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Label">
                    <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Rt.Tag.Accent" TargetType="Label" BasedOn="{StaticResource Rt.Tag}">
        <Setter Property="Foreground" Value="{StaticResource Rt.Brush.Yellow}" />
        <Setter Property="BorderBrush" Value="#73FFD60A" />
        <Setter Property="Background" Value="#12FFD60A" />
    </Style>

    <Style x:Key="Rt.Tag.Info" TargetType="Label" BasedOn="{StaticResource Rt.Tag}">
        <Setter Property="Foreground" Value="{StaticResource Rt.Brush.Info}" />
        <Setter Property="BorderBrush" Value="#732DE2FF" />
    </Style>

    <Style x:Key="Rt.Tag.Success" TargetType="Label" BasedOn="{StaticResource Rt.Tag}">
        <Setter Property="Foreground" Value="{StaticResource Rt.Brush.Success}" />
        <Setter Property="BorderBrush" Value="#665DFF8F" />
    </Style>

    <Style x:Key="Rt.Tag.Warning" TargetType="Label" BasedOn="{StaticResource Rt.Tag}">
        <Setter Property="Foreground" Value="{StaticResource Rt.Brush.Warning}" />
        <Setter Property="BorderBrush" Value="#73FF8C1A" />
    </Style>

    <Style x:Key="Rt.Tag.Danger" TargetType="Label" BasedOn="{StaticResource Rt.Tag}">
        <Setter Property="Foreground" Value="{StaticResource Rt.Brush.DangerText}" />
        <Setter Property="BorderBrush" Value="#73FF4D5E" />
    </Style>

    <!-- ========== Data grid ========== -->
    <Style x:Key="Rt.DataGridColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#0AFFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource Rt.Brush.Cyan}" />
        <Setter Property="FontFamily" Value="{StaticResource Rt.Font.Pixel}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Padding" Value="12,11" />
        <Setter Property="BorderBrush" Value="{StaticResource Rt.Brush.Stripes}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Rt.DataGridCell" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#40FF2E9A" />
                <Setter Property="Foreground" Value="{StaticResource Rt.Brush.Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Rt.DataGridRow" TargetType="DataGridRow">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Rt.Brush.Hover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Rt.DataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource Rt.Brush.Panel}" />
        <Setter Property="Foreground" Value="{StaticResource Rt.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Rt.Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="#05FFFFFF" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#26A63DFF" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="FontFamily" Value="{StaticResource Rt.Font.Body}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource Rt.DataGridColumnHeader}" />
        <Setter Property="CellStyle" Value="{StaticResource Rt.DataGridCell}" />
        <Setter Property="RowStyle" Value="{StaticResource Rt.DataGridRow}" />
    </Style>

    <!-- ========== Scroll bars: thin dark track, violet thumb that lights cyan on hover ========== -->
    <Style x:Key="Rt.ScrollBarThumb" TargetType="Thumb">
        <Setter Property="Background" Value="#80A63DFF" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="4" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#CC2DE2FF" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter Property="Background" Value="{StaticResource Rt.Brush.C3}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Rt.ScrollBarPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Rt.ScrollBar" TargetType="ScrollBar">
        <Setter Property="Background" Value="{StaticResource Rt.Brush.Input}" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Rt.ScrollBarPage}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Rt.ScrollBarThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Rt.ScrollBarPage}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Rt.ScrollBarPage}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Rt.ScrollBarThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Rt.ScrollBarPage}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========== Tooltip ========== -->
    <Style x:Key="Rt.ToolTip" TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Rt.Brush.Cyan}" />
        <Setter Property="FontFamily" Value="{StaticResource Rt.Font.Term}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border CornerRadius="4" Background="#F5050409" BorderBrush="{StaticResource Rt.Brush.Cyan}" BorderThickness="1"
                            Padding="10,6" Margin="8">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="14" Color="#FF2DE2FF" Opacity="0.35" />
                        </Border.Effect>
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
