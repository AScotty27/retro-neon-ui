<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the shipped WinForms files and renders a themed form offscreen (DrawToBitmap, never shown).
       Run: dotnet run -c Release, then the output PNG path after a double dash. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\dotnet\winforms\RetroPalette.cs" Link="RetroNeon\RetroPalette.cs" />
    <Compile Include="..\..\dotnet\winforms\RetroFonts.cs" Link="RetroNeon\RetroFonts.cs" />
    <Compile Include="..\..\dotnet\winforms\RetroTheme.cs" Link="RetroNeon\RetroTheme.cs" />
    <None Include="..\..\dotnet\fonts\*.ttf" Link="Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
